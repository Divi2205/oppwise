# Leave DATABASE_URL empty to use the built-in local database (PGlite, stored in ./.pglite).
# For deployment, set it to a PostgreSQL connection string (e.g. a free Neon database).
DATABASE_URL=

# Optional. Long random string used to sign login sessions (if unset, one is derived
# from DATABASE_URL in deployment). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Only emails from this domain can register (college spaces).
ALLOWED_EMAIL_DOMAIN=srmist.edu.in
